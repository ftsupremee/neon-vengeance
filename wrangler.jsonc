{
  // Local-dev config only; deployment uses manifest.json via the Sites SDK.
  "name": "neon-vengeance",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "local-dev", "database_id": "local" }
  ]
}
